# Template for live connector credentials.
# Copy to .env.live and fill in.  .env.live is gitignored.
#
#   cp .env.example .env.live
#   $EDITOR .env.live
#   set -a; source .env.live; set +a
#   uvicorn src.main:app --port 8100        # local API on :8100 with live conns

# --- GitHub ---
# Fine-grained PAT: https://github.com/settings/personal-access-tokens/new
# Required permission: Pull requests: Read (single permission, read-only)
GITHUB_TOKEN=github_pat_REPLACE_ME
# Comma-separated owner/repo list. Each repo = one HTTP call per query (pages of 100).
GITHUB_REPOS=fastapi/fastapi

# --- Jira Cloud ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://YOURSITE.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=REPLACE_ME
# Comma-separated project keys. Used as default JQL filter when query has no project predicate.
JIRA_PROJECTS=ENG,PLATFORM

# --- Gateway ---
# Must match what mints the JWTs (defaults to demo-shared-secret in compose).
USQL_JWT_SECRET=demo-shared-secret
